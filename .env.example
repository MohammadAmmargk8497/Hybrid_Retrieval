# Copy to `.env` and edit. All keys optional — defaults shown.
# Shell env vars take precedence over `.env`.

# Where your PDFs live (will be scanned recursively in a future change).
HR_PDF_DIRECTORY=~/Downloads

# Where the index, BM25 model, and tracking files are persisted.
HR_PERSIST_DIRECTORY=~/.hybrid_retrieval

# Chunking. See docs/changes/0003-shrink-chunk-size.md for rationale.
HR_CHUNK_SIZE=1200
HR_CHUNK_OVERLAP=150

# Retrieval depth.
HR_TOP_K=5
# HR_CANDIDATE_K=20   # per-ranker depth fed into RRF; defaults to 4×TOP_K

# GROBID extraction service. Start it with: docker compose up -d
HR_GROBID_URL=http://localhost:8070
HR_GROBID_TIMEOUT_S=60

# Qdrant vector store (also from `docker compose up -d`).
HR_QDRANT_URL=http://localhost:6333
HR_QDRANT_TIMEOUT_S=30

# Embedder. Nomic v1.5 is Matryoshka — truncating to 512d ≈ 2× faster
# search vs. native 768 with negligible quality loss.
HR_EMBEDDING_MODEL=nomic-ai/nomic-embed-text-v1.5
HR_EMBEDDING_DIM=512
HR_EMBED_CACHE_SIZE=1024
